<Window x:Class="ProductCosting.App.Views.ImportColumnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ProductCosting.App.Infrastructure"
        Style="{StaticResource AppWindow}" Background="{DynamicResource CardBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" SizeToContent="Height" Width="620" ShowInTaskbar="False">
    <StackPanel Margin="24,22,24,20" LayoutTransform="{x:Static l:UiScale.Transform}">
        <TextBlock Text="{l:T import.columns.title}" Style="{StaticResource H2}" FontSize="17" />
        <TextBlock Text="{l:T import.columns.help}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14" />
        <CheckBox x:Name="HeaderBox" Content="{l:T import.columns.header}" Margin="0,0,0,14" Checked="HeaderBox_Changed" Unchecked="HeaderBox_Changed" />
        <!-- one row per field: which column of the file holds it -->
        <Grid x:Name="Fields">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>
        <TextBlock x:Name="Missing" Text="{l:T import.columns.missing}" Foreground="{DynamicResource WarningTextBrush}" Margin="0,12,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="{l:T import.cancel}" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="90" />
            <Button x:Name="OkButton" Content="{l:T common.continue}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
