<Window x:Class="ProductCosting.App.Views.SupplierHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ProductCosting.App.Infrastructure"
        xmlns:c="clr-namespace:ProductCosting.App.Controls"
        Style="{StaticResource AppWindow}" Width="960" SizeToContent="Height" MinWidth="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="24" LayoutTransform="{x:Static l:UiScale.Transform}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Style="{StaticResource H1}" FontSize="20" Margin="0,0,0,16" />
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
            <c:ChangeChart x:Name="Chart" />
        </Border>
        <Border x:Name="TableCard" Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0" VerticalAlignment="Top" l:RoundClip.Enabled="True">
            <!-- the window grows with the table up to about ten rows, then the table scrolls -->
            <DataGrid x:Name="Table" MaxHeight="440" VirtualizingPanel.IsVirtualizing="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T history.date}" Binding="{Binding DateText}" Width="*" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:T supplierHistory.items}" Binding="{Binding ChangedText}" Width="200"
                                        ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" />
                    <DataGridTextColumn Header="{l:T supplierHistory.upDownCol}" Binding="{Binding UpDownText}" Width="160"
                                        ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" />
                    <DataGridTemplateColumn Header="{l:T supplierHistory.avg}" Width="170" HeaderStyle="{StaticResource NumHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AvgText}" Foreground="{Binding AvgBrush}" Style="{StaticResource NumCell}" FontWeight="SemiBold" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
