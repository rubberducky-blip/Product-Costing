<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>ProductCosting.App</RootNamespace>
    <AssemblyName>ProductCosting</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Fluent theme is marked experimental in WPF -->
    <NoWarn>$(NoWarn);WPF0001;MVVMTK0045;MVVMTK0034</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProductCosting.Core\ProductCosting.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.png" />
  </ItemGroup>
</Project>
