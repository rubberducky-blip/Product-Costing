<Window x:Class="ProductCosting.App.Views.WishListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ProductCosting.App.Infrastructure"
        xmlns:c="clr-namespace:ProductCosting.App.Controls"
        Style="{StaticResource AppWindow}" Width="1080" Height="760" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24" LayoutTransform="{x:Static l:UiScale.Transform}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{l:T wish.title}" Style="{StaticResource H1}" FontSize="20" />
            <TextBlock Text="{l:T wish.help}" Style="{StaticResource Caption}" Margin="0,4,0,14" TextWrapping="Wrap" />
        </StackPanel>

        <!-- add an item with its quantity -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:SearchPicker x:Name="ItemPicker" Placeholder="{l:T wish.pick}" Picked="ItemPicker_Picked" />
                <l:NumBox x:Name="AddQty" Grid.Column="1" Margin="10,0,0,0" l:Hint.Text="{l:T order.qty}" />
                <TextBlock x:Name="AddUnit" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="36" Foreground="{DynamicResource TextMutedBrush}" />
                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" l:Btn.Icon="&#xE710;" Content="{l:T wish.add}" Margin="10,0,0,0" Click="Add_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" l:RoundClip.Enabled="True">
            <Grid>
                <TextBlock x:Name="EmptyText" Text="{l:T wish.empty}" Style="{StaticResource Muted}" Margin="20,16" />
                <DataGrid x:Name="Table" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44">
                            <DataGridTemplateColumn.Header>
                                <CheckBox x:Name="AllBox" IsChecked="True" Click="All_Click" ToolTip="{l:T wish.all}" MinWidth="0" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" MinWidth="0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:T list.code}" Binding="{Binding Code}" Width="110" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{l:T list.name}" Binding="{Binding Name}" Width="1.4*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="{l:T list.supplier}" Binding="{Binding Suppliers}" Width="*" ElementStyle="{StaticResource MutedCell}" />
                        <DataGridTemplateColumn Header="{l:T order.qty}" Width="200" HeaderStyle="{StaticResource NumHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4,3">
                                        <!-- already on a draft or executed order (hover: which) -->
                                        <Border DockPanel.Dock="Right" Background="Transparent" Width="22" ToolTip="{Binding MentionsText}" ToolTipService.InitialShowDelay="150">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTextBrush}" Visibility="{Binding HasMentions, Converter={StaticResource Visible}}" />
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding UnitText}" VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="32"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <l:NumBox Field="{Binding Qty}" MinHeight="30" />
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="48">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource IconButton}" l:Btn.Icon="&#xE711;" ToolTip="{l:T common.remove}" Click="Remove_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- turn the ticked items into draft orders -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,12" Margin="0,14,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="CreateButton" Style="{StaticResource PrimaryButton}" l:Btn.Icon="&#xE7BF;" Content="{l:T wish.create}"
                        Click="Create_Click" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="CheapestOption" GroupName="mode" IsChecked="True" Content="{l:T wish.cheapest}" ToolTip="{l:T wish.cheapestHelp}" Margin="0,0,18,0" />
                    <RadioButton x:Name="FewestOption" GroupName="mode" Content="{l:T wish.fewest}" ToolTip="{l:T wish.fewestHelp}" Margin="0,0,24,0" />
                    <TextBlock Text="{l:T wish.region}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" />
                    <ComboBox x:Name="RegionBox" Width="190" SelectedValuePath="Value" DisplayMemberPath="Label" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
