<Window x:Class="ProductCosting.App.Views.SupplierPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ProductCosting.App.Infrastructure"
        xmlns:c="clr-namespace:ProductCosting.App.Controls"
        Style="{StaticResource AppWindow}" Background="{DynamicResource CardBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" SizeToContent="Height" Width="480" ShowInTaskbar="False">
    <Grid Margin="24,22,24,20" LayoutTransform="{x:Static l:UiScale.Transform}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{l:T order.newPick}" Style="{StaticResource H2}" FontSize="17" />
        <c:SearchPicker x:Name="Picker" Grid.Row="1" Margin="0,16,0,0" Placeholder="{l:T item.pickSupplier}" Picked="Picker_Picked" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="{l:T common.cancel}" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="90" />
            <Button x:Name="OkButton" Content="{l:T supplier.newOrder}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsDefault="True" IsEnabled="False"
                    Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
