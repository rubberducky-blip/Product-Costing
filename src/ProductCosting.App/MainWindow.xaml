<Window x:Class="ProductCosting.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ProductCosting.App.Infrastructure"
        xmlns:vm="clr-namespace:ProductCosting.App.ViewModels"
        xmlns:v="clr-namespace:ProductCosting.App.Views"
        xmlns:c="clr-namespace:ProductCosting.App.Controls"
        Style="{StaticResource AppWindow}"
        Title="{l:T app.title}" Width="1440" Height="900" MinWidth="1100" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Icon="Assets/app.png">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ListPageViewModel}">
            <v:ListPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ItemEditorViewModel}">
            <v:ItemEditor />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SupplierEditorViewModel}">
            <v:SupplierEditor />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- sidebar -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,26">
                    <Image Source="Assets/app.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{l:T app.title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" MaxWidth="160" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <RadioButton Style="{StaticResource NavButton}" l:Btn.Icon="&#xE713;" Content="{l:T nav.settings}"
                                 Command="{Binding GoCommand}" CommandParameter="settings"
                                 IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=settings}" />
                    <TextBlock Text="{Binding Version}" Style="{StaticResource Caption}" Margin="12,12,0,0" />
                </StackPanel>
                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" l:Btn.Icon="&#xE7B8;" Content="{l:T nav.products}"
                                 Command="{Binding GoCommand}" CommandParameter="products"
                                 IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=products}" />
                    <RadioButton Style="{StaticResource NavButton}" l:Btn.Icon="&#xE719;" Content="{l:T nav.merchandise}"
                                 Command="{Binding GoCommand}" CommandParameter="merchandise"
                                 IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=merchandise}" />
                    <RadioButton Style="{StaticResource NavButton}" l:Btn.Icon="&#xE81E;" Content="{l:T nav.raw}"
                                 Command="{Binding GoCommand}" CommandParameter="raw"
                                 IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=raw}" />
                    <RadioButton Style="{StaticResource NavButton}" l:Btn.Icon="&#xE716;" Content="{l:T nav.suppliers}"
                                 Command="{Binding GoCommand}" CommandParameter="suppliers"
                                 IsChecked="{Binding Section, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=suppliers}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- main -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- top bar -->
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid HorizontalAlignment="Left" Width="520" DataContext="{Binding Search}">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" l:Btn.Icon="Ctrl F" MinHeight="36"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 l:Hint.Text="{l:T search.placeholder}" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                        <Popup IsOpen="{Binding IsOpen}" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" VerticalOffset="6"
                               StaysOpen="False" AllowsTransparency="True" Width="620">
                            <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="6" Margin="0,0,12,12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.55" Color="Black" />
                                </Border.Effect>
                                <Grid>
                                    <TextBlock Text="{l:T common.noResults}" Style="{StaticResource Muted}" Margin="12,10"
                                               Visibility="{Binding NoResults, Converter={StaticResource Visible}}" />
                                    <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" MaxHeight="460"
                                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PickItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             PreviewMouseLeftButtonUp="SearchResults_MouseUp">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left">
                                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" HorizontalAlignment="Center"
                                                                   Foreground="{StaticResource AccentTextBrush}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Code}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,10,0" />
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding KindText}" Style="{StaticResource Caption}"
                                                                   Visibility="{Binding HasSnippet, Converter={StaticResource Hidden}}" />
                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasSnippet, Converter={StaticResource Visible}}">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE90A;" FontSize="11" Margin="0,1,6,0"
                                                                       Foreground="{StaticResource AccentTextBrush}" />
                                                            <TextBlock Text="{Binding Snippet}" FontSize="12" FontStyle="Italic" Foreground="{StaticResource TextMutedBrush}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding PriceText}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,4,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- bell -->
                    <Grid Grid.Column="1" DataContext="{Binding Notifications}">
                        <Button x:Name="BellButton" Style="{StaticResource IconButton}" Width="40" Height="40" Command="{Binding ToggleCommand}"
                                ToolTip="{l:T notify.title}">
                            <Grid>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEA8F;" FontSize="18" />
                            </Grid>
                        </Button>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" MinWidth="18" Height="18" CornerRadius="9"
                                Background="{StaticResource DangerBrush}" Padding="5,0" IsHitTestVisible="False"
                                Visibility="{Binding Count, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding Count}" FontSize="10.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Popup IsOpen="{Binding IsOpen}" PlacementTarget="{Binding ElementName=BellButton}" Placement="Bottom"
                               HorizontalOffset="-488" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True">
                            <v:NotificationsPanel />
                        </Popup>
                    </Grid>
                </Grid>
            </Border>

            <c:PageHost Grid.Row="1" Page="{Binding Current}" />

            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Top" MinHeight="0"
                         Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />

            <!-- toast -->
            <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24" Padding="16,11"
                    Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="8"
                    Visibility="{Binding Toast, Converter={StaticResource Visible}}" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource SuccessTextBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Toast}" MaxWidth="420" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
