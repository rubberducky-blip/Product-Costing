<Window x:Class="ProductCosting.App.Views.PriceHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ProductCosting.App.Infrastructure"
        xmlns:c="clr-namespace:ProductCosting.App.Controls"
        Style="{StaticResource AppWindow}" Width="1180" Height="600" MinWidth="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="24" LayoutTransform="{x:Static l:UiScale.Transform}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Style="{StaticResource H1}" FontSize="20" Margin="0,0,0,16" />
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
            <c:PriceChart x:Name="Chart" />
        </Border>
        <Border x:Name="TableCard" Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0" VerticalAlignment="Top" l:RoundClip.Enabled="True">
            <!-- the window grows with the table up to about ten rows, then the table scrolls -->
            <DataGrid x:Name="Table" MaxHeight="440" VirtualizingPanel.IsVirtualizing="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T history.date}" Binding="{Binding DateText}" Width="150" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:T history.price}" Binding="{Binding PriceText}" Width="120" ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" />
                    <DataGridTemplateColumn Header="{l:T history.change}" Width="190" HeaderStyle="{StaticResource NumHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ChangeText}" Foreground="{Binding ChangeBrush}" Style="{StaticResource NumCell}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{l:T history.margin}" Width="170" HeaderStyle="{StaticResource NumHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MarginText}" Foreground="{Binding MarginBrush}" Style="{StaticResource NumCell}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:T history.reasons}" Binding="{Binding ReasonsText}" Width="*" MinWidth="200" ElementStyle="{StaticResource MutedCell}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
