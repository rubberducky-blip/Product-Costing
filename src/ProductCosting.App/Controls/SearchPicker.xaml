<UserControl x:Class="ProductCosting.App.Controls.SearchPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ProductCosting.App.Infrastructure"
             xmlns:c="clr-namespace:ProductCosting.App.Controls"
             x:Name="Root" MinHeight="32" Focusable="False">
    <Grid>
        <Button x:Name="Opener" Click="Opener_Click" Cursor="Hand" FocusVisualStyle="{x:Null}" MinHeight="32">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="10,0,8,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DisplayText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Style="{StaticResource Icon}" FontSize="11" Text="&#xE70D;" Margin="8,0,0,0"
                           Foreground="{StaticResource TextMutedBrush}" />
            </Grid>
        </Button>
        <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Opener}" Placement="Bottom" VerticalOffset="4"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="Pop_Closed" Opened="Pop_Opened">
            <Border x:Name="PopBorder" Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="6" Margin="0,0,10,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <DockPanel>
                    <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="2,2,2,6" TextChanged="FilterBox_TextChanged"
                             PreviewKeyDown="FilterBox_PreviewKeyDown" l:Hint.Text="{l:T common.filter}" />
                    <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Text="{l:T common.noResults}" Style="{StaticResource Caption}"
                               Margin="10,6" Visibility="Collapsed" />
                    <ListBox x:Name="List" MaxHeight="380" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource PickItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="c:PickerEntry">
                                <Grid Margin="{Binding Indent}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Style="{StaticResource FolderIcon}" Width="16" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                                    Visibility="{Binding HasGlyph, Converter={StaticResource Visible}}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="T" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding ShowPath, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                               Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                        <Setter TargetName="T" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                        <Setter TargetName="T" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSection}" Value="True">
                                        <Setter TargetName="T" Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                                        <Setter TargetName="T" Property="FontSize" Value="11.5" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
