<UserControl x:Class="ProductCosting.App.Views.OrdersTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ProductCosting.App.Infrastructure"
             x:Name="Root">
    <UserControl.Resources>
        <!-- side by side on the Orders page: equal columns with a 16px gap -->
        <ItemsPanelTemplate x:Key="Columns">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
        <Style x:Key="ColumnItem" TargetType="ContentPresenter">
            <Setter Property="Margin" Value="8,0" />
        </Style>

        <!-- one table per order state; empty tables are replaced by a short note -->
        <DataTemplate x:Key="Section">
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16" VerticalAlignment="Top" l:RoundClip.Enabled="True">
                <StackPanel>
                    <DockPanel Margin="20,16,16,12" MinHeight="30">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" l:Btn.Icon="&#xE7BF;" Content="{l:T supplier.newOrder}"
                                Command="{Binding NewCommand}" Padding="12,5" MinHeight="0"
                                Visibility="{Binding HasNew, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{l:T order.none}" Style="{StaticResource Muted}" Margin="20,0,20,16"
                               Visibility="{Binding HasRows, Converter={StaticResource Hidden}}" />
                    <DataGrid ItemsSource="{Binding Rows}" SelectionMode="Single" Visibility="{Binding HasRows, Converter={StaticResource Visible}}"
                              MouseDoubleClick="Grid_MouseDoubleClick" ContextMenuOpening="Grid_ContextMenuOpening" Loaded="Grid_Loaded">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:T common.open}" Click="Menu_Open" />
                                <MenuItem Header="{l:T order.export}" Click="Menu_Export" />
                                <MenuItem Header="{l:T order.execute}" Click="Menu_Execute" Tag="draft" />
                                <MenuItem Header="{l:T order.archive}" Click="Menu_Archive" Tag="executed" />
                                <MenuItem Header="{l:T order.unarchive}" Click="Menu_Unarchive" Tag="archived" />
                                <Separator />
                                <MenuItem Header="{l:T common.delete}" Click="Menu_Delete" Foreground="{DynamicResource DangerTextBrush}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T list.supplier}" Binding="{Binding SupplierName}" Width="1.4*" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="{l:T order.date}" Binding="{Binding DateText}" Width="*" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="{l:T order.linesCol}" Binding="{Binding LineCount}" Width="100"
                                                ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" />
                            <DataGridTextColumn Header="{l:T order.totalCol}" Binding="{Binding TotalText}" Width="120"
                                                ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" />
                            <DataGridTextColumn Header="{l:T order.value}" Binding="{Binding ValueText}" Width="140"
                                                ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ItemsControl x:Name="Sections" ItemTemplate="{StaticResource Section}" />
</UserControl>
