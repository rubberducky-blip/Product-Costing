<UserControl x:Class="ProductCosting.App.Views.ListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ProductCosting.App.Infrastructure"
             xmlns:m="clr-namespace:ProductCosting.Core.Model;assembly=ProductCosting.Core">
    <UserControl.Resources>
        <!-- folder tile -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="214" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AllowDrop" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
                </Trigger>
                <Trigger Property="l:DropHint.Position" Value="3">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
                <Trigger Property="l:DropHint.Position" Value="1">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="3,1,1,1" />
                </Trigger>
                <Trigger Property="l:DropHint.Position" Value="2">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="1,1,3,1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CrumbButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="AllowDrop" Value="True" />
            <Style.Triggers>
                <Trigger Property="l:DropHint.Position" Value="3">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowStyle" TargetType="DataGridRow" BasedOn="{StaticResource AppRow}">
            <Setter Property="AllowDrop" Value="True" />
            <EventSetter Event="MouseEnter" Handler="Row_MouseEnter" />
            <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick" />
            <EventSetter Event="DragOver" Handler="Row_DragOver" />
            <EventSetter Event="DragLeave" Handler="Target_DragLeave" />
            <EventSetter Event="Drop" Handler="Row_Drop" />
        </Style>

        <DataTemplate x:Key="NameCell">
            <StackPanel VerticalAlignment="Center" Margin="4,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Padding="7,1"
                            Visibility="{Binding IsMerchandiseAsMaterial, Converter={StaticResource Visible}}">
                        <TextBlock Text="{l:T kind.merchandise}" FontSize="11" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding FolderPath}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding FolderPath, Converter={StaticResource Visible}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- breadcrumb: drop rows or folders here to move them up -->
        <ItemsControl ItemsSource="{Binding Crumbs}" Margin="-8,0,0,4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource CrumbButton}" Content="{Binding Name}" Tag="{Binding Id}"
                                Click="Crumb_Click" DragOver="Crumb_DragOver" DragLeave="Target_DragLeave" Drop="Crumb_Drop" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Foreground="{DynamicResource TextFaintBrush}" Margin="2,0"
                                   Visibility="{Binding IsLast, Converter={StaticResource Hidden}}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- title + actions -->
        <DockPanel Grid.Row="1" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding NewFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource FolderPlusIcon}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:T folder.new}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" l:Btn.Icon="&#xE710;" Content="{Binding NewText}" Command="{Binding NewCommand}" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" Visibility="{Binding InFolder, Converter={StaticResource Hidden}}" />
                <TextBlock Text="{Binding CurrentFolderName}" Style="{StaticResource H1}" Visibility="{Binding InFolder, Converter={StaticResource Visible}}" />
            </StackPanel>
        </DockPanel>

        <!-- toolbar -->
        <DockPanel Grid.Row="2" Margin="0,0,0,16">
            <Border DockPanel.Dock="Right" Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:T sort.title}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,6,0" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="{Binding CodeSortText}"
                                 Command="{Binding SetSortCommand}" CommandParameter="{x:Static m:SortMode.Code}"
                                 IsChecked="{Binding SortMode, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Code}" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T sort.manual}"
                                 Command="{Binding SetSortCommand}" CommandParameter="{x:Static m:SortMode.Manual}"
                                 IsChecked="{Binding SortMode, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Manual}" />
                </StackPanel>
            </Border>
            <TextBox x:Name="FilterBox" Style="{StaticResource SearchBox}" Tag="&#xE71C;" Width="340" HorizontalAlignment="Left"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                     l:Hint.Text="{l:T common.filter}" PreviewKeyDown="FilterBox_PreviewKeyDown" />
            <TextBlock Text="{l:T list.filterResults}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0"
                       Visibility="{Binding IsFiltering, Converter={StaticResource Visible}}" />
        </DockPanel>

        <!-- folder tiles -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Tiles}" Visibility="{Binding ShowTiles, Converter={StaticResource Visible}}" Margin="0,0,0,6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Tile}" Tag="{Binding Id}"
                            PreviewMouseLeftButtonDown="Tile_MouseDown" PreviewMouseMove="Tile_MouseMove" MouseLeftButtonUp="Tile_MouseUp"
                            DragOver="Tile_DragOver" DragLeave="Target_DragLeave" Drop="Tile_Drop">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:T common.open}" Click="TileMenu_Open" />
                                <MenuItem Header="{l:T common.rename}" Click="TileMenu_Rename" />
                                <Separator />
                                <MenuItem Header="{l:T common.delete}" Click="TileMenu_Delete" Foreground="{DynamicResource DangerTextBrush}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Style="{StaticResource FolderIcon}" Width="30" Height="25" Margin="2,0,12,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- table -->
        <Grid Grid.Row="4">
        <Border Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top" l:RoundClip.Enabled="True"
                Visibility="{Binding HasRows, Converter={StaticResource Visible}}">
            <Grid>
                <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding Rows}" RowStyle="{StaticResource RowStyle}"
                          Visibility="{Binding IsSuppliers, Converter={StaticResource Hidden}}"
                          PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown" PreviewMouseMove="Grid_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="Grid_PreviewMouseLeftButtonUp" PreviewKeyDown="Grid_PreviewKeyDown"
                          ContextMenuOpening="Grid_ContextMenuOpening">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{l:T common.open}" Click="Menu_Open" />
                            <MenuItem Header="{l:T common.duplicate}" Click="Menu_Duplicate" />
                            <MenuItem Header="{l:T item.history}" Click="Menu_History" Tag="item" />
                            <MenuItem Header="{l:T menu.setPrice}" Click="Menu_SetPrice" Tag="item" />
                            <MenuItem Header="{l:T menu.setPurchase}" Click="Menu_SetPurchase" Tag="bought" />
                            <MenuItem Header="{l:T supplier.newOrder}" Click="Menu_NewOrder" Tag="supplier" />
                            <Separator />
                            <MenuItem Header="{l:T common.delete}" Click="Menu_Delete" Foreground="{DynamicResource DangerTextBrush}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="CodeCol" Header="{l:T list.code}" Width="160" SortMemberPath="Code">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                                        <Ellipse Style="{StaticResource GlowDot}" Visibility="{Binding HasUnseenChange, Converter={StaticResource Visible}}" />
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource WarningTextBrush}" ToolTip="{l:T cost.warnConversion}"
                                                   Visibility="{Binding HasWarnings, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:T list.name}" Width="2*" MinWidth="260" CellTemplate="{StaticResource NameCell}" SortMemberPath="Name" />
                        <DataGridTextColumn x:Name="SupplierCol" Header="{l:T list.supplier}" Binding="{Binding Suppliers}" Width="1.5*" MinWidth="240" ElementStyle="{StaticResource MutedCell}" />
                        <DataGridTextColumn x:Name="SupplierCodeCol" Header="{l:T list.supplierCode}" Binding="{Binding SupplierCode}" Width="150" ElementStyle="{StaticResource MutedCell}" />
                        <DataGridTextColumn x:Name="UnitCol" Header="{l:T list.unit}" Binding="{Binding Unit, Converter={StaticResource UnitName}}" Width="80" ElementStyle="{StaticResource MutedCell}" />
                        <DataGridTextColumn x:Name="PurchaseCol" Header="{l:T list.purchase}" Binding="{Binding Converter={StaticResource PurchasePrice}}" Width="120"
                                            ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" SortMemberPath="PurchasePrice" />
                        <DataGridTextColumn Header="{l:T list.cost}" Binding="{Binding Cost, Converter={StaticResource Money4}}" Width="120"
                                            ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" SortMemberPath="Cost" />
                        <DataGridTemplateColumn Header="{l:T list.price}" Width="120" SortMemberPath="Price" HeaderStyle="{StaticResource NumHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Price, Converter={StaticResource Money}}" FontWeight="SemiBold" Style="{StaticResource NumCell}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="ProfitCol" Header="{l:T list.profit}" Binding="{Binding Profit, Converter={StaticResource Money}}" Width="120"
                                            ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" SortMemberPath="Profit" />
                        <DataGridTextColumn Header="{l:T list.markup}" Binding="{Binding EffMarkup, Converter={StaticResource Pct}}" Width="120"
                                            ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" SortMemberPath="EffMarkup" />
                        <DataGridTemplateColumn Header="{l:T list.margin}" Width="120" SortMemberPath="MarginPct" HeaderStyle="{StaticResource NumHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MarginPct, Converter={StaticResource Pct}}" Style="{StaticResource NumCell}" FontWeight="SemiBold"
                                               Foreground="{Binding MarginPct, Converter={StaticResource MarginBrush}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid x:Name="SuppliersGrid" ItemsSource="{Binding Rows}" RowStyle="{StaticResource RowStyle}"
                          Visibility="{Binding IsSuppliers, Converter={StaticResource Visible}}"
                          PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown" PreviewMouseMove="Grid_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="Grid_PreviewMouseLeftButtonUp" PreviewKeyDown="Grid_PreviewKeyDown"
                          ContextMenuOpening="Grid_ContextMenuOpening">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{l:T common.open}" Click="Menu_Open" />
                            <MenuItem Header="{l:T common.duplicate}" Click="Menu_Duplicate" />
                            <MenuItem Header="{l:T item.history}" Click="Menu_History" Tag="item" />
                            <MenuItem Header="{l:T menu.setPrice}" Click="Menu_SetPrice" Tag="item" />
                            <MenuItem Header="{l:T menu.setPurchase}" Click="Menu_SetPurchase" Tag="bought" />
                            <MenuItem Header="{l:T supplier.newOrder}" Click="Menu_NewOrder" Tag="supplier" />
                            <Separator />
                            <MenuItem Header="{l:T common.delete}" Click="Menu_Delete" Foreground="{DynamicResource DangerTextBrush}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{l:T supplier.name}" Width="2*" MinWidth="260" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FolderPath}" Style="{StaticResource Caption}"
                                                   Visibility="{Binding FolderPath, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:T list.country}" Binding="{Binding CountryName}" Width="170" ElementStyle="{StaticResource MutedCell}" />
                        <DataGridTextColumn Header="{l:T list.currency}" Binding="{Binding Currency, Converter={StaticResource CurrencyName}}" Width="110" ElementStyle="{StaticResource MutedCell}" />
                        <DataGridTextColumn Header="{l:T list.discount}" Binding="{Binding DiscountPct, Converter={StaticResource Pct}}" Width="120"
                                            ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" />
                        <DataGridTextColumn Header="{l:T list.shipping}" Binding="{Binding ShippingPct, Converter={StaticResource Pct}}" Width="120"
                                            ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" />
                        <DataGridTextColumn Header="{l:T list.email}" Binding="{Binding Email}" Width="*" ElementStyle="{StaticResource MutedCell}" />
                        <DataGridTextColumn Header="{l:T list.phone}" Binding="{Binding Phone}" Width="*" ElementStyle="{StaticResource MutedCell}" />
                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
        </Border>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}"
                    IsHitTestVisible="False">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource TextFaintBrush}" />
            <TextBlock Text="{l:T common.empty}" Style="{StaticResource Muted}" Margin="0,10,0,0" HorizontalAlignment="Center" />
            <TextBlock Text="{l:T list.dragHint}" Style="{StaticResource Caption}" Margin="0,4,0,0" HorizontalAlignment="Center" />
        </StackPanel>
        </Grid>
    </Grid>
</UserControl>
