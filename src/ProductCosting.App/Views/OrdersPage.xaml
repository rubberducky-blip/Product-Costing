<UserControl x:Class="ProductCosting.App.Views.OrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ProductCosting.App.Infrastructure"
             xmlns:v="clr-namespace:ProductCosting.App.Views">
    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{l:T nav.orders}" Style="{StaticResource H1}" Margin="0,24,0,18" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <v:OrdersTable Drafts="{Binding Drafts}" Executed="{Binding Executed}" NewOrderCommand="{Binding NewCommand}"
                          ShowSupplier="True" SideBySide="True" />
        </ScrollViewer>
    </Grid>
</UserControl>
