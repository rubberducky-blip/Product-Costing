<Window x:Class="ProductCosting.App.Views.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ProductCosting.App.Infrastructure"
        Style="{StaticResource AppWindow}" Width="1280" Height="760" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}" />
            <TextBlock Text="{l:T order.help}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
        </StackPanel>
        <TextBox x:Name="FilterBox" Grid.Row="1" Width="320" Style="{StaticResource SearchBox}" Tag="&#xE71C;" HorizontalAlignment="Left" Margin="0,16,0,12"
                 l:Hint.Text="{l:T common.filter}" TextChanged="FilterBox_TextChanged" />
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top" l:RoundClip.Enabled="True">
            <DataGrid x:Name="Grid" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T list.supplierCode}" Binding="{Binding SupplierCode}" Width="150" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:T order.ourCode}" Binding="{Binding Code}" Width="120" ElementStyle="{StaticResource MutedCell}" />
                    <DataGridTextColumn Header="{l:T list.name}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:T item.variant}" Binding="{Binding Variant}" Width="160" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:T list.unit}" Binding="{Binding UnitText}" Width="70" ElementStyle="{StaticResource MutedCell}" />
                    <DataGridTextColumn Header="{l:T item.moq}" Binding="{Binding MoqText}" Width="110" ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" />
                    <DataGridTextColumn Header="{l:T item.pack}" Binding="{Binding PackText}" Width="120" ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" />
                    <DataGridTemplateColumn Header="{l:T order.qty}" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <l:NumBox Field="{Binding Qty}" MinHeight="30" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" HorizontalAlignment="Right"
                                               Foreground="{StaticResource WarningTextBrush}" ToolTip="{Binding Warning}"
                                               Visibility="{Binding Warning, Converter={StaticResource Visible}}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
            <Button DockPanel.Dock="Right" Content="{l:T common.close}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Close_Click" />
            <Button DockPanel.Dock="Right" Content="{l:T order.export}" l:Btn.Icon="&#xE896;" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Export_Click" />
            <Button DockPanel.Dock="Right" Content="{l:T order.clear}" l:Btn.Icon="&#xE894;" Style="{StaticResource GhostButton}" Click="Clear_Click" />
            <Button x:Name="FixButton" DockPanel.Dock="Right" Content="{l:T order.fix}" l:Btn.Icon="&#xE8C9;" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" Click="Fix_Click" ToolTip="{l:T order.fixHelp}" />
        </DockPanel>
    </Grid>
</Window>
