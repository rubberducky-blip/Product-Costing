<UserControl x:Class="ProductCosting.App.Views.NotificationsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ProductCosting.App.Infrastructure"
             Width="540">
    <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="12" Margin="0,0,12,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <DockPanel>
            <!-- header -->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,14,12,12">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:T notify.hideAll}" Padding="10,5" MinHeight="0"
                                Command="{Binding HideAllCommand}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:T notify.title}" Style="{StaticResource H2}" FontSize="16" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Badge}" Margin="10,0,0,0">
                                <TextBlock Text="{Binding Count}" />
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource PrimaryButton}" l:Btn.Icon="&#xE8C9;" Content="{l:T notify.expansion}"
                                Command="{Binding ExpansionCommand}" ToolTip="{l:T notify.expansionHelp}" Padding="12,6" MinHeight="0" Margin="0,0,8,0"
                                Visibility="{Binding CanExpand, Converter={StaticResource Visible}}" />
                        <Button Style="{StaticResource SecondaryButton}" l:Btn.Icon="&#xE896;" Content="{l:T notify.export}"
                                Command="{Binding ExportCommand}" Padding="12,6" MinHeight="0"
                                IsEnabled="{Binding HasItems}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid>
                <TextBlock Text="{l:T notify.empty}" Style="{StaticResource Muted}" Margin="18,24" HorizontalAlignment="Center"
                           Visibility="{Binding Count, Converter={StaticResource Hidden}}" />
                <ListBox ItemsSource="{Binding Items}" MaxHeight="560" Background="Transparent" BorderThickness="0" Padding="6"
                         ItemContainerStyle="{StaticResource PlainItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" CornerRadius="8" Padding="12,10" Margin="0,2" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="IconBg" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Top" HorizontalAlignment="Left"
                                            Background="{StaticResource SuccessSoftBrush}">
                                        <TextBlock x:Name="Arrow" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource SuccessTextBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource LinkButton}" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" HorizontalAlignment="Left">
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="·" Foreground="{StaticResource TextFaintBrush}" />
                                                    <Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                                                </TextBlock>
                                            </Button>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding OldText}" Foreground="{StaticResource TextMutedBrush}" TextDecorations="Strikethrough" />
                                            <TextBlock Text="  →  " Foreground="{StaticResource TextFaintBrush}" />
                                            <TextBlock Text="{Binding NewText}" FontWeight="SemiBold" />
                                            <TextBlock x:Name="Change" Text="{Binding ChangeText}" Margin="10,0,0,0" Foreground="{StaticResource SuccessTextBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ReasonsText}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Style="{StaticResource SecondaryButton}" Content="{l:T notify.adjust}" l:Btn.Icon="&#xE777;"
                                                    Padding="10,4" MinHeight="0" FontSize="12" ToolTip="{Binding AdjustTip}"
                                                    Command="{Binding DataContext.AdjustCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding CanAdjust, Converter={StaticResource Visible}}" />
                                            <Border Style="{StaticResource Badge}" Visibility="{Binding Adjusted, Converter={StaticResource Visible}}">
                                                <TextBlock Text="{Binding AdjustedText}" />
                                            </Border>
                                            <Button Style="{StaticResource GhostButton}" Content="{l:T notify.hide}" Padding="10,4" MinHeight="0" FontSize="12" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.HideCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsIncrease}" Value="True">
                                    <Setter TargetName="IconBg" Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                    <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource DangerTextBrush}" />
                                    <Setter TargetName="Change" Property="Foreground" Value="{StaticResource DangerTextBrush}" />
                                </DataTrigger>
                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{StaticResource HoverBrush}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
