<Window x:Class="ProductCosting.App.Views.SupplierPdfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ProductCosting.App.Infrastructure"
        xmlns:v="clr-namespace:ProductCosting.App.Views"
        Style="{StaticResource AppWindow}" Background="{DynamicResource CardBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" SizeToContent="Height" Width="680" ShowInTaskbar="False">
    <StackPanel Margin="24,22,24,20" LayoutTransform="{x:Static l:UiScale.Transform}">
        <TextBlock x:Name="TitleText" Style="{StaticResource H2}" FontSize="17" />
        <TextBlock Text="{l:T pdfopt.supplierHelp}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,16" />
        <v:OrderPdfOptionsView x:Name="Options" />
        <TextBlock Text="{l:T pdfopt.note}" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
        <TextBox x:Name="NoteBox" Style="{StaticResource MultiLine}" MinHeight="70" l:Hint.Text="{l:T pdfopt.noteHint}" />
        <DockPanel Margin="0,22,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" l:Btn.Icon="&#xE7A7;" Content="{l:T pdfopt.reset}" Click="Reset_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:T common.cancel}" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="90" />
                <Button Content="{l:T common.ok}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsDefault="True" MinWidth="90" Click="Ok_Click" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
