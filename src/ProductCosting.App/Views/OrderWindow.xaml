<Window x:Class="ProductCosting.App.Views.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ProductCosting.App.Infrastructure"
        Style="{StaticResource AppWindow}" Width="1500" Height="860" MinWidth="980" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24" LayoutTransform="{x:Static l:UiScale.Transform}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TitleText" Style="{StaticResource H1}" />
                <Border x:Name="StatusBadge" Style="{StaticResource Badge}" Margin="14,4,0,0">
                    <TextBlock x:Name="StatusText" />
                </Border>
            </StackPanel>
            <TextBlock x:Name="HelpText" Text="{l:T order.help}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
        </StackPanel>
        <TextBox x:Name="FilterBox" Grid.Row="1" Width="320" Style="{StaticResource SearchBox}" Tag="&#xE71C;" HorizontalAlignment="Left" Margin="0,16,0,12"
                 l:Hint.Text="{l:T common.filter}" TextChanged="FilterBox_TextChanged" />

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top" l:RoundClip.Enabled="True">
            <DataGrid x:Name="Grid" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T list.supplierCode}" Binding="{Binding SupplierCode}" Width="140" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:T order.ourCode}" Binding="{Binding Code}" Width="110" ElementStyle="{StaticResource MutedCell}" />
                    <!-- a mark when another supplier sells the item cheaper (hover: who and for how much) -->
                    <DataGridTemplateColumn Header="{l:T list.name}" Width="*" MinWidth="180" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel VerticalAlignment="Center" Margin="4,0">
                                    <Border DockPanel.Dock="Right" Background="Transparent" ToolTipService.InitialShowDelay="150"
                                            Visibility="{Binding HasCheaper, Converter={StaticResource Visible}}" Margin="6,0,0,0">
                                        <Border.ToolTip>
                                            <ToolTip>
                                                <ItemsControl ItemsSource="{Binding Cheaper}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="N" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="P" />
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="D" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Price}" Margin="16,0,0,0" HorizontalAlignment="Right" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Difference}" Margin="12,0,0,0" HorizontalAlignment="Right"
                                                                           Foreground="{DynamicResource SuccessTextBrush}" FontWeight="SemiBold" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Grid.IsSharedSizeScope="True" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </ToolTip>
                                        </Border.ToolTip>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8EC;" FontSize="13" Foreground="{DynamicResource WarningTextBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:T item.variant}" Binding="{Binding Variant}" Width="130" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:T list.unit}" Binding="{Binding UnitText}" Width="70" ElementStyle="{StaticResource MutedCell}" />
                    <DataGridTextColumn x:Name="MoqCol" Header="{l:T item.moq}" Binding="{Binding MoqText}" Width="130" ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" />
                    <DataGridTextColumn x:Name="PackCol" Header="{l:T item.pack}" Binding="{Binding PackText}" Width="130" ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" />
                    <DataGridTextColumn Header="{l:T order.unitPrice}" Binding="{Binding UnitPriceText}" Width="120" ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" />
                    <DataGridTemplateColumn Header="{l:T order.qty}" Width="190" HeaderStyle="{StaticResource NumHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- the quantity, then marks: below the minimum / not whole packs, already on another order, on the shopping list -->
                                <DockPanel Margin="4,3">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Margin="3,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource WarningTextBrush}" ToolTip="{Binding Warning}"
                                                   Visibility="{Binding Warning, Converter={StaticResource Visible}}" />
                                        <Border Background="Transparent" ToolTip="{Binding MentionsText}" ToolTipService.InitialShowDelay="150" Margin="3,0"
                                                Visibility="{Binding HasMentions, Converter={StaticResource Visible}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="13" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTextBrush}" />
                                        </Border>
                                        <Button Click="TakeWish_Click" ToolTip="{Binding WishText}" Width="24" Height="24" Padding="0" MinWidth="0" MinHeight="0"
                                                Cursor="Hand" Visibility="{Binding HasWish, Converter={StaticResource Visible}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{DynamicResource AccentSoftBrush}" CornerRadius="5">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AccentTextBrush}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                    <l:NumBox Field="{Binding Qty}" MinHeight="30" IsReadOnly="{Binding IsReadOnly}" PreviewKeyDown="Qty_PreviewKeyDown" />
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:T order.value}" Binding="{Binding ValueText}" Width="120" ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- totals -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="{l:T order.totals}" Style="{StaticResource H2}" Margin="0,0,0,12" />
                <ItemsControl x:Name="TotalsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="Row" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Label" Text="{Binding Label}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="Value" Grid.Column="1" Text="{Binding Value}" Margin="12,0,0,0" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsBig}" Value="True">
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                    <Setter TargetName="Value" Property="FontWeight" Value="Bold" />
                                    <Setter TargetName="Value" Property="FontSize" Value="17" />
                                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                    <Setter TargetName="Row" Property="Margin" Value="0,10,0,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSub}" Value="True">
                                    <Setter TargetName="Label" Property="FontSize" Value="11.5" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
                                    <Setter TargetName="Value" Property="FontSize" Value="11.5" />
                                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                    <Setter TargetName="Row" Property="Margin" Value="0,2" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{l:T order.shippingNote}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
            <Button DockPanel.Dock="Right" Content="{l:T common.close}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Close_Click" />
            <Button x:Name="ExecuteButton" DockPanel.Dock="Right" Content="{l:T order.execute}" l:Btn.Icon="&#xE73E;" Style="{StaticResource PrimaryButton}"
                    Margin="8,0,0,0" Click="Execute_Click" ToolTip="{l:T order.executeHelp}" />
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="{l:T common.save}" l:Btn.Icon="&#xE74E;" Style="{StaticResource SecondaryButton}"
                    Margin="8,0,0,0" Click="Save_Click" />
            <Button DockPanel.Dock="Right" Content="{l:T order.export}" l:Btn.Icon="&#xE896;" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Export_Click" />
            <Button x:Name="FixButton" DockPanel.Dock="Right" Content="{l:T order.fix}" l:Btn.Icon="&#xE8C9;" Style="{StaticResource SecondaryButton}"
                    Margin="8,0,0,0" Click="Fix_Click" ToolTip="{l:T order.fixHelp}" />
            <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="{l:T order.clear}" l:Btn.Icon="&#xE894;" Style="{StaticResource GhostButton}" Click="Clear_Click" />
        </DockPanel>
    </Grid>
</Window>
