<Window x:Class="ProductCosting.App.Views.SupplierHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ProductCosting.App.Infrastructure"
        xmlns:c="clr-namespace:ProductCosting.App.Controls"
        Style="{StaticResource AppWindow}" Width="960" Height="700" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24" LayoutTransform="{x:Static l:UiScale.Transform}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="300" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Style="{StaticResource H1}" FontSize="20" />
        <TextBlock Grid.Row="1" Text="{l:T supplierHistory.help}" Style="{StaticResource Caption}" Margin="0,4,0,16" />
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
            <c:ChangeChart x:Name="Chart" />
        </Border>
        <Border x:Name="TableCard" Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0" VerticalAlignment="Top" l:RoundClip.Enabled="True">
            <DataGrid x:Name="Table">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T history.date}" Binding="{Binding DateText}" Width="*" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:T supplierHistory.items}" Binding="{Binding ChangedText}" Width="200"
                                        ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" />
                    <DataGridTextColumn Header="{l:T supplierHistory.upDownCol}" Binding="{Binding UpDownText}" Width="160"
                                        ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" />
                    <DataGridTemplateColumn Header="{l:T supplierHistory.avg}" Width="170" HeaderStyle="{StaticResource NumHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AvgText}" Foreground="{Binding AvgBrush}" Style="{StaticResource NumCell}" FontWeight="SemiBold" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Button Grid.Row="4" HorizontalAlignment="Right" Margin="0,16,0,0" Content="{l:T common.close}" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="Close_Click" />
    </Grid>
</Window>
