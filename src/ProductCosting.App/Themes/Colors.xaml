<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#3B82F6</Color>
    <Color x:Key="DangerColor">#EF4444</Color>

    <SolidColorBrush x:Key="WindowBrush" Color="#0E1014" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#14171C" />
    <SolidColorBrush x:Key="CardBrush" Color="#181C22" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1F242C" />
    <SolidColorBrush x:Key="InsetBrush" Color="#121519" />
    <SolidColorBrush x:Key="PopupBrush" Color="#1B1F26" />
    <SolidColorBrush x:Key="LineBrush" Color="#262B33" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="#363C47" />
    <SolidColorBrush x:Key="TextBrush" Color="#E8EBF0" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9BA3B0" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#69717E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5B97F8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A2B47" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#82B1FF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#F87171" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A1A1D" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#15301F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#36290F" />
    <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#223B82F6" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
</ResourceDictionary>
