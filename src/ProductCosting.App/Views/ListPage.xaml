<UserControl x:Class="ProductCosting.App.Views.ListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ProductCosting.App.Infrastructure"
             xmlns:m="clr-namespace:ProductCosting.Core.Model;assembly=ProductCosting.Core">
    <UserControl.Resources>
        <!-- folder tile -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="214" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AllowDrop" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
                </Trigger>
                <Trigger Property="l:DropHint.Position" Value="3">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="l:DropHint.Position" Value="1">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="3,1,1,1" />
                </Trigger>
                <Trigger Property="l:DropHint.Position" Value="2">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="1,1,3,1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CrumbButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="AllowDrop" Value="True" />
            <Style.Triggers>
                <Trigger Property="l:DropHint.Position" Value="3">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="BorderThickness" Value="0,2,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <EventSetter Event="MouseEnter" Handler="Row_MouseEnter" />
            <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick" />
            <EventSetter Event="DragOver" Handler="Row_DragOver" />
            <EventSetter Event="DragLeave" Handler="Target_DragLeave" />
            <EventSetter Event="Drop" Handler="Row_Drop" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="{l:T common.open}" Click="Menu_Open" />
                        <Separator />
                        <MenuItem Header="{l:T common.delete}" Click="Menu_Delete" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="l:DropHint.Position" Value="1">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="0,2,0,0" />
                </Trigger>
                <Trigger Property="l:DropHint.Position" Value="2">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="NameCell">
            <StackPanel VerticalAlignment="Center" Margin="4,0">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding FolderPath}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding FolderPath, Converter={StaticResource Visible}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- breadcrumb: drop rows or folders here to move them up -->
        <ItemsControl ItemsSource="{Binding Crumbs}" Margin="-8,0,0,4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource CrumbButton}" Content="{Binding Name}" Tag="{Binding Id}"
                                Click="Crumb_Click" DragOver="Crumb_DragOver" DragLeave="Target_DragLeave" Drop="Crumb_Drop" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Foreground="{StaticResource TextFaintBrush}" Margin="2,0"
                                   Visibility="{Binding IsLast, Converter={StaticResource Hidden}}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- title + actions -->
        <DockPanel Grid.Row="1" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" l:Btn.Icon="&#xE8F4;" Content="{l:T folder.new}" Command="{Binding NewFolderCommand}" />
                <Button Style="{StaticResource PrimaryButton}" l:Btn.Icon="&#xE710;" Content="{Binding NewText}" Command="{Binding NewCommand}" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" Visibility="{Binding InFolder, Converter={StaticResource Hidden}}" />
                <TextBlock Text="{Binding CurrentFolderName}" Style="{StaticResource H1}" Visibility="{Binding InFolder, Converter={StaticResource Visible}}" />
                <Border Style="{StaticResource Badge}" Margin="12,4,0,0" Background="{StaticResource CardHoverBrush}">
                    <TextBlock Text="{Binding CountText}" Foreground="{StaticResource TextMutedBrush}" />
                </Border>
                <Button Style="{StaticResource IconButton}" l:Btn.Icon="&#xE70F;" ToolTip="{l:T folder.rename}" Margin="10,2,0,0"
                        Command="{Binding RenameFolderCommand}" Visibility="{Binding InFolder, Converter={StaticResource Visible}}" />
                <Button Style="{StaticResource IconButton}" l:Btn.Icon="&#xE74D;" ToolTip="{l:T folder.delete}" Margin="2,2,0,0"
                        Command="{Binding DeleteFolderCommand}" Visibility="{Binding InFolder, Converter={StaticResource Visible}}" />
            </StackPanel>
        </DockPanel>

        <!-- toolbar -->
        <DockPanel Grid.Row="2" Margin="0,0,0,16">
            <Border DockPanel.Dock="Right" Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="7" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:T sort.title}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,6,0" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="{Binding CodeSortText}"
                                 Command="{Binding SetSortCommand}" CommandParameter="{x:Static m:SortMode.Code}"
                                 IsChecked="{Binding SortMode, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Code}" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="{l:T sort.manual}"
                                 Command="{Binding SetSortCommand}" CommandParameter="{x:Static m:SortMode.Manual}"
                                 IsChecked="{Binding SortMode, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Manual}" />
                </StackPanel>
            </Border>
            <Grid Width="340" HorizontalAlignment="Left">
                <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}" Padding="32,6,10,6"
                         l:Hint.Text="{l:T common.filter}" PreviewKeyDown="FilterBox_PreviewKeyDown" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" FontSize="12" Margin="11,0,0,0" HorizontalAlignment="Left"
                           Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False" />
            </Grid>
            <TextBlock Text="{l:T list.filterResults}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0"
                       Visibility="{Binding IsFiltering, Converter={StaticResource Visible}}" />
        </DockPanel>

        <!-- folder tiles -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Tiles}" Visibility="{Binding ShowTiles, Converter={StaticResource Visible}}" Margin="0,0,0,6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Tile}" Tag="{Binding Id}"
                            PreviewMouseLeftButtonDown="Tile_MouseDown" PreviewMouseMove="Tile_MouseMove" MouseLeftButtonUp="Tile_MouseUp"
                            DragOver="Tile_DragOver" DragLeave="Target_DragLeave" Drop="Tile_Drop">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:T common.open}" Click="TileMenu_Open" />
                                <MenuItem Header="{l:T common.rename}" Click="TileMenu_Rename" />
                                <Separator />
                                <MenuItem Header="{l:T common.delete}" Click="TileMenu_Delete" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource WarningSoftBrush}" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="17" HorizontalAlignment="Center"
                                           Foreground="{StaticResource WarningTextBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                    <Run Text="{Binding ItemCount, Mode=OneWay}" /> <Run Text="{l:T folder.items}" /><Run Text=" · " /><Run Text="{Binding FolderCount, Mode=OneWay}" /> <Run Text="{l:T folder.folders}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- table -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding Rows}" RowStyle="{StaticResource RowStyle}"
                          Visibility="{Binding IsSuppliers, Converter={StaticResource Hidden}}"
                          PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown" PreviewMouseMove="Grid_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="Grid_PreviewMouseLeftButtonUp" PreviewKeyDown="Grid_PreviewKeyDown">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="CodeCol" Header="{l:T list.code}" Width="150" SortMemberPath="Code">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                                        <Ellipse Style="{StaticResource GlowDot}" Visibility="{Binding HasUnseenChange, Converter={StaticResource Visible}}" />
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Margin="8,0,0,0"
                                                   Foreground="{StaticResource WarningTextBrush}" ToolTip="{l:T cost.warnConversion}"
                                                   Visibility="{Binding HasWarnings, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{l:T list.name}" Width="2*" MinWidth="200" CellTemplate="{StaticResource NameCell}" SortMemberPath="Name" />
                        <DataGridTemplateColumn x:Name="TypeCol" Header="{l:T list.type}" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" Margin="4,0"
                                            Visibility="{Binding IsMerchandiseAsMaterial, Converter={StaticResource Visible}}">
                                        <TextBlock Text="{l:T kind.merchandise}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="SupplierCol" Header="{l:T list.supplier}" Binding="{Binding Suppliers}" Width="*" MinWidth="120" ElementStyle="{StaticResource MutedCell}" />
                        <DataGridTextColumn x:Name="SupplierCodeCol" Header="{l:T list.supplierCode}" Binding="{Binding SupplierCode}" Width="130" ElementStyle="{StaticResource MutedCell}" />
                        <DataGridTextColumn x:Name="UnitCol" Header="{l:T list.unit}" Binding="{Binding Unit, Converter={StaticResource UnitName}}" Width="70" ElementStyle="{StaticResource MutedCell}" />
                        <DataGridTextColumn Header="{l:T list.cost}" Binding="{Binding Cost, Converter={StaticResource Money4}}" Width="110"
                                            ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" SortMemberPath="Cost" />
                        <DataGridTemplateColumn Header="{l:T list.price}" Width="110" SortMemberPath="Price" HeaderStyle="{StaticResource RightHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Price, Converter={StaticResource Money}}" FontWeight="SemiBold" Style="{StaticResource RightCell}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="ProfitCol" Header="{l:T list.profit}" Binding="{Binding Profit, Converter={StaticResource Money}}" Width="100"
                                            ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" SortMemberPath="Profit" />
                        <DataGridTextColumn Header="{l:T list.margin}" Binding="{Binding MarginPct, Converter={StaticResource Pct}}" Width="90"
                                            ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" SortMemberPath="MarginPct" />
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid x:Name="SuppliersGrid" ItemsSource="{Binding Rows}" RowStyle="{StaticResource RowStyle}"
                          Visibility="{Binding IsSuppliers, Converter={StaticResource Visible}}"
                          PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown" PreviewMouseMove="Grid_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="Grid_PreviewMouseLeftButtonUp" PreviewKeyDown="Grid_PreviewKeyDown">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{l:T supplier.name}" Width="2*" MinWidth="200" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FolderPath}" Style="{StaticResource Caption}"
                                                   Visibility="{Binding FolderPath, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{l:T list.country}" Binding="{Binding Country}" Width="*" ElementStyle="{StaticResource MutedCell}" />
                        <DataGridTextColumn Header="{l:T list.currency}" Binding="{Binding Currency, Converter={StaticResource CurrencyName}}" Width="90" ElementStyle="{StaticResource MutedCell}" />
                        <DataGridTextColumn Header="{l:T list.discount}" Binding="{Binding DiscountPct, Converter={StaticResource Pct}}" Width="95"
                                            ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" />
                        <DataGridTextColumn Header="{l:T list.shipping}" Binding="{Binding ShippingPct, Converter={StaticResource Pct}}" Width="100"
                                            ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" />
                        <DataGridTextColumn Header="{l:T list.items}" Binding="{Binding ItemCount}" Width="70"
                                            ElementStyle="{StaticResource RightCell}" HeaderStyle="{StaticResource RightHeader}" />
                        <DataGridTextColumn Header="{l:T list.email}" Binding="{Binding Email}" Width="*" ElementStyle="{StaticResource MutedCell}" />
                        <DataGridTextColumn Header="{l:T list.phone}" Binding="{Binding Phone}" Width="130" ElementStyle="{StaticResource MutedCell}" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}"
                            IsHitTestVisible="False">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="34" HorizontalAlignment="Center" Foreground="{StaticResource TextFaintBrush}" />
                    <TextBlock Text="{l:T common.empty}" Style="{StaticResource Muted}" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="{l:T list.dragHint}" Style="{StaticResource Caption}" Margin="0,4,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
