<Window x:Class="ProductCosting.App.Views.PriceHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:ProductCosting.App.Infrastructure"
        xmlns:c="clr-namespace:ProductCosting.App.Controls"
        Style="{StaticResource AppWindow}" Width="960" Height="700" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="320" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Style="{StaticResource H1}" FontSize="20" Margin="0,0,0,16" />
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
            <c:PriceChart x:Name="Chart" />
        </Border>
        <Border x:Name="TableCard" Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0" VerticalAlignment="Top" l:RoundClip.Enabled="True">
            <DataGrid x:Name="Table">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T history.date}" Binding="{Binding DateText}" Width="150" ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{l:T history.price}" Binding="{Binding PriceText}" Width="120" ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" />
                    <DataGridTemplateColumn Header="{l:T history.change}" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ChangeText}" Foreground="{Binding ChangeBrush}" Style="{StaticResource NumCell}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{l:T history.reasons}" Binding="{Binding ReasonsText}" Width="*" ElementStyle="{StaticResource MutedCell}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Button Grid.Row="3" HorizontalAlignment="Right" Margin="0,16,0,0" Content="{l:T common.close}" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="Close_Click" />
    </Grid>
</Window>
