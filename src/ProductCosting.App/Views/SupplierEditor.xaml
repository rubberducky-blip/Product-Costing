<UserControl x:Class="ProductCosting.App.Views.SupplierEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ProductCosting.App.Infrastructure"
             xmlns:c="clr-namespace:ProductCosting.App.Controls"
             x:Name="Root">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,14,28,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource DangerButton}" l:Btn.Icon="&#xE74D;" Content="{l:T common.delete}" Command="{Binding DeleteCommand}" />
                    <Button Style="{StaticResource SecondaryButton}" l:Btn.Icon="&#xE7A7;" Content="{l:T common.cancelChanges}" Command="{Binding CancelCommand}"
                            IsEnabled="{Binding Dirty}" Margin="8,0,0,0" />
                    <Button Style="{StaticResource PrimaryButton}" l:Btn.Icon="&#xE74E;" Content="{l:T common.save}" Command="{Binding SaveCommand}"
                            IsEnabled="{Binding Dirty}" Margin="8,0,0,0" MinWidth="120" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" ClipToBounds="True">
                    <Button Style="{StaticResource IconButton}" l:Btn.Icon="&#xE72B;" Command="{Binding BackCommand}" ToolTip="{l:T common.back}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" FontSize="21" VerticalAlignment="Center" MaxWidth="520" />
                    <Border Style="{StaticResource Badge}" Margin="12,2,0,0">
                        <TextBlock Text="{l:T kind.supplier}" />
                    </Border>
                    <Border Style="{StaticResource Badge}" Margin="8,2,0,0" Background="{StaticResource WarningSoftBrush}"
                            Visibility="{Binding Dirty, Converter={StaticResource Visible}}">
                        <TextBlock Text="{l:T common.unsaved}" Foreground="{StaticResource WarningTextBrush}" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="28,22,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{l:T supplier.general}" Style="{StaticResource H2}" Margin="0,0,0,14" />
                        <TextBlock Text="{l:T supplier.name}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T folder.field}" Style="{StaticResource FieldLabel}" />
                                <c:SearchPicker ItemsSource="{Binding FolderEntries}" SelectedId="{Binding FolderId}" Placeholder="{l:T item.pickFolder}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:T supplier.country}" Style="{StaticResource FieldLabel}" />
                                <c:SearchPicker ItemsSource="{Binding CountryEntries}" SelectedId="{Binding CountryId}" Placeholder="{l:T supplier.pickCountry}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T supplier.discount}" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis" />
                                <l:NumBox Field="{Binding Discount}" l:Hint.Text="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:T supplier.shipping}" Style="{StaticResource FieldLabel}" />
                                <l:NumBox Field="{Binding Shipping}" ToolTip="{l:T supplier.shippingHelp}" l:Hint.Text="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{l:T supplier.currency}" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Currencies}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Currency}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{l:T supplier.shippingHelp}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T supplier.email}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:T supplier.phone}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{l:T common.notes}" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLine}" MinHeight="96" />
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top" l:RoundClip.Enabled="True">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="20,16,16,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" l:Btn.Icon="&#xE7BF;" Content="{l:T supplier.newOrder}"
                                Command="{Binding NewOrderCommand}" Visibility="{Binding IsNew, Converter={StaticResource Hidden}}" Padding="12,5" MinHeight="0" />
                        <TextBlock Text="{l:T supplier.items}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <TextBlock Text="{l:T supplier.noItems}" Style="{StaticResource Muted}" Margin="20,0,20,16" Visibility="{Binding HasItems, Converter={StaticResource Hidden}}" />
                        <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding Items}" Visibility="{Binding HasItems, Converter={StaticResource Visible}}"
                                  MouseDoubleClick="ItemsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T list.code}" Binding="{Binding Code}" Width="110" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{l:T list.name}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{l:T list.supplierCode}" Binding="{Binding SupplierCode}" Width="120" ElementStyle="{StaticResource MutedCell}" />
                                <DataGridTextColumn Header="{l:T item.purchasePrice}" Binding="{Binding PurchasePrice, Converter={StaticResource Num2}}" Width="100"
                                                    ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" />
                                <DataGridTextColumn Header="{l:T list.currency}" Binding="{Binding Currency, Converter={StaticResource CurrencyName}}" Width="80" ElementStyle="{StaticResource MutedCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
