<UserControl x:Class="ProductCosting.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:ProductCosting.App.Infrastructure"
             xmlns:v="clr-namespace:ProductCosting.App.Views"
             x:Name="Root">
    <UserControl.Resources>
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Width" Value="240" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" l:Btn.Icon="&#xE7A7;" Content="{l:T common.cancelChanges}" Command="{Binding CancelCommand}"
                            IsEnabled="{Binding Dirty}" />
                    <Button Style="{StaticResource PrimaryButton}" l:Btn.Icon="&#xE74E;" Content="{l:T common.save}" Command="{Binding SaveCommand}"
                            IsEnabled="{Binding Dirty}" Margin="8,0,0,0" MinWidth="120" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:T settings.title}" Style="{StaticResource H1}" FontSize="21" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Badge}" Margin="12,2,0,0" Background="{DynamicResource WarningSoftBrush}"
                            Visibility="{Binding Dirty, Converter={StaticResource Visible}}">
                        <TextBlock Text="{l:T common.unsaved}" Foreground="{DynamicResource WarningTextBrush}" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,22,28,28">
            <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:T settings.costs}" Style="{StaticResource H2}" Margin="0,0,0,14" />
                        <WrapPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="{l:T settings.laborRate}" Style="{StaticResource FieldLabel}" />
                                <l:NumBox Field="{Binding LaborRate}" Decimals="2" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="{l:T settings.overheadRate}" Style="{StaticResource FieldLabel}" />
                                <l:NumBox Field="{Binding OverheadRate}" Decimals="2" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:T settings.pricing}" Style="{StaticResource H2}" Margin="0,0,0,14" />
                        <!-- the four pricing fields share one row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T settings.defaultMarkup}" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis" />
                                <l:NumBox Field="{Binding DefaultMarkup}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:T settings.roundingStep}" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis" />
                                <l:NumBox Field="{Binding RoundingStep}" Decimals="2" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{l:T settings.roundingMode}" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis" />
                                <ComboBox ItemsSource="{Binding RoundingModes}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding RoundingMode}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="{l:T settings.salesOverhead}" Style="{StaticResource FieldLabel}" TextTrimming="CharacterEllipsis" />
                                <l:NumBox Field="{Binding SalesOverhead}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:T settings.currency}" Style="{StaticResource H2}" Margin="0,0,0,14" />
                        <WrapPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="{l:T settings.currencySymbol}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="{l:T settings.usdRate}" Style="{StaticResource FieldLabel}" />
                                <l:NumBox Field="{Binding UsdPerEur}" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="{l:T settings.usdRateHelp}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:T settings.appearance}" Style="{StaticResource H2}" Margin="0,0,0,14" />
                        <WrapPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="{l:T settings.theme}" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Themes}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Theme}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="{l:T settings.textSize}" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Sizes}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding UiScale}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource Field}">
                                <TextBlock Text="{l:T settings.language}" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Languages}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Language}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- order PDFs (a supplier can have its own) -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:T pdfopt.title}" Style="{StaticResource H2}" Margin="0,0,0,14" />
                        <v:OrderPdfOptionsView DataContext="{Binding Pdf}" />
                    </StackPanel>
                </Border>

                <!-- our company, for the top of order PDFs; the logo is saved as soon as it is chosen -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:T company.title}" Style="{StaticResource H2}" />
                        <TextBlock Text="{l:T company.help}" Style="{StaticResource Caption}" Margin="0,4,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:T company.name}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Grid.ColumnSpan="3">
                                <TextBlock Text="{l:T company.address}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CompanyAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <UniformGrid Grid.Row="1" Grid.ColumnSpan="5" Rows="1" Margin="-8,12,-8,0">
                                <UniformGrid.Resources>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Margin" Value="8,0" />
                                    </Style>
                                </UniformGrid.Resources>
                                <StackPanel>
                                    <TextBlock Text="{l:T company.vat}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding CompanyVat, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{l:T company.taxOffice}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding CompanyTaxOffice, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{l:T company.phone}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding CompanyPhone, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{l:T company.email}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding CompanyEmail, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                        <TextBlock Text="{l:T company.logo}" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                        <StackPanel Orientation="Horizontal">
                            <Border Width="160" Height="64" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Background="White" Padding="6">
                                <Grid>
                                    <Image Source="{Binding Logo}" Stretch="Uniform" />
                                    <TextBlock Text="{l:T company.noLogo}" Foreground="#888888" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasLogo, Converter={StaticResource Hidden}}" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" l:Btn.Icon="&#xEB9F;" Content="{l:T company.chooseLogo}" Command="{Binding ChooseLogoCommand}" />
                                <Button Style="{StaticResource GhostButton}" l:Btn.Icon="&#xE74D;" Content="{l:T company.removeLogo}" Command="{Binding RemoveLogoCommand}"
                                        Margin="0,6,0,0" HorizontalAlignment="Left" Visibility="{Binding HasLogo, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- backups: these controls apply immediately -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}" l:Btn.Icon="&#xE8E5;" Content="{l:T settings.restoreFile}" Command="{Binding RestoreFileCommand}" />
                                <Button Style="{StaticResource PrimaryButton}" l:Btn.Icon="&#xE896;" Content="{l:T settings.backupNow}" Command="{Binding BackupNowCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{l:T settings.backups}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{l:T settings.backupsHelp}" Style="{StaticResource Caption}" Margin="0,0,0,14" />

                        <TextBlock Text="{l:T settings.backupFolder}" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" l:Btn.Icon="&#xE838;" Content="{l:T settings.openFolder}"
                                    Command="{Binding OpenFolderCommand}" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{l:T settings.chooseFolder}"
                                    Command="{Binding ChooseFolderCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding BackupFolder, Mode=OneWay}" IsReadOnly="True" />
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <CheckBox Content="{l:T settings.autoBackup}" IsChecked="{Binding AutoBackup}" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T settings.keep}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="28,0,10,0" />
                            <l:NumBox Field="{Binding KeepCount}" Width="80" LostFocus="Keep_LostFocus" />
                            <TextBlock Text="{Binding LastAutoText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="20,0,0,0" />
                        </StackPanel>

                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,16,0,0" MaxHeight="340" l:RoundClip.Enabled="True">
                            <Grid>
                                <TextBlock Text="{l:T settings.noBackups}" Style="{StaticResource Muted}" Margin="14,12"
                                           Visibility="{Binding HasBackups, Converter={StaticResource Hidden}}" />
                                <DataGrid ItemsSource="{Binding Backups}" Visibility="{Binding HasBackups, Converter={StaticResource Visible}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{l:T backup.date}" Binding="{Binding DateText}" Width="170" ElementStyle="{StaticResource CellText}" />
                                        <DataGridTextColumn Header="{l:T backup.kind}" Binding="{Binding KindText}" Width="150" ElementStyle="{StaticResource MutedCell}" />
                                        <DataGridTextColumn Header="{l:T backup.size}" Binding="{Binding SizeBytes, Converter={StaticResource FileSize}}" Width="90"
                                                            ElementStyle="{StaticResource NumCell}" HeaderStyle="{StaticResource NumHeader}" />
                                        <DataGridTextColumn Header="" Binding="{Binding FileName}" Width="*" ElementStyle="{StaticResource MutedCell}" />
                                        <DataGridTemplateColumn Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource GhostButton}" Content="{l:T settings.restore}" l:Btn.Icon="&#xE777;"
                                                            Padding="10,3" MinHeight="0" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextBrush}"
                                                            Command="{Binding DataContext.RestoreCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:T keys.title}" Style="{StaticResource H2}" Margin="0,0,0,4" />
                        <TextBlock Text="{l:T keys.help}" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Shortcuts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- click and press the new keys; Backspace switches the shortcut off -->
                                        <l:HotkeyBox GestureText="{Binding Keys}" FontWeight="SemiBold" ToolTip="{l:T keys.recordHelp}"
                                                     Visibility="{Binding IsEditable, Converter={StaticResource Visible}}" />
                                        <Border Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1"
                                                CornerRadius="5" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Visibility="{Binding IsFixed, Converter={StaticResource Visible}}">
                                            <TextBlock Text="{Binding Keys}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                        <!-- a small × back to the default; it never changes the row's height -->
                                        <Button Grid.Column="1" Command="{Binding ResetCommand}" ToolTip="{l:T keys.reset}" Width="22" Height="22" Padding="0"
                                                MinWidth="0" MinHeight="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" Cursor="Hand"
                                                Visibility="{Binding IsChanged, Converter={StaticResource VisibleKeepSpace}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="11">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:T settings.data}" Style="{StaticResource H2}" Margin="0,0,0,14" />
                        <Button Style="{StaticResource PrimaryButton}" l:Btn.Icon="&#xE8B5;" Content="{l:T import.button}" Command="{Binding ImportCommand}"
                                HorizontalAlignment="Left" />
                        <TextBlock Text="{l:T import.help}" Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left" Margin="0,6,0,16" />
                        <TextBlock Text="{l:T settings.dbLocation}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding DatabasePath, Mode=OneWay}" IsReadOnly="True" />
                        <Button Style="{StaticResource SecondaryButton}" l:Btn.Icon="&#xE72C;" Content="{l:T settings.recalc}" Command="{Binding RecalculateAllCommand}"
                                HorizontalAlignment="Left" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
